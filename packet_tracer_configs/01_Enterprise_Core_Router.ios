! ==============================================================================
! CISCO VIRTUAL INTERNSHIP 2026 - CYBER SECURITY PROJECT
! Component: Enterprise Campus & Data Center Core Router
! Device: Cisco 2911 / 4331 Integrated Services Router
! Hostname: ENT-CORE-RTR-01
! Description: Core routing, Inter-VLAN aggregation, OSPF, and Inside Gateway
! ==============================================================================

enable
configure terminal

! --- Basic System & Security Hardening ---
hostname ENT-CORE-RTR-01
no ip domain-lookup
ip domain-name enterprise.netacad.internal
service password-encryption

! Strong Secret for Privileged EXEC Mode
enable secret Cisco@NetAcad2026!Secure

! Global Security Banner
banner motd ^C
================================================================================
  UNAUTHORIZED ACCESS TO THIS ENTERPRISE NETWORK DEVICE IS STRICTLY PROHIBITED.
  ALL SESSIONS ARE ENCRYPTED, MONITORED, LOGGED, AND AUDITED BY CISCO SECUREX.
  VIOLATORS WILL BE PROSECUTED UNDER CYBER SECURITY REGULATIONS (IT ACT 2000).
================================================================================
^C

! --- Management Authentication & AAA (Cisco ISE / Local Fallback) ---
aaa new-model
aaa authentication login default local
aaa authorization exec default local

username admin privilege 15 secret Admin@NetAcad2026!P@ss

! Secure SSH Configuration
crypto key generate rsa modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3

line con 0
 exec-timeout 10 0
 logging synchronous
 login authentication default
 transport output none

line vty 0 4
 exec-timeout 10 0
 logging synchronous
 login authentication default
 transport input ssh
 transport output none

! --- Enterprise Data Center & Campus Interfaces ---
! Uplink to Enterprise Core / Distribution Switch (802.1Q Trunk)
interface GigabitEthernet0/0
 description UPLINK-TO-ENT-DC-SWITCH-TRUNK
 no shutdown

! Sub-interfaces for VLAN Routing (Router-on-a-Stick / Core Gateway)
interface GigabitEthernet0/0.10
 description FACULTY-VLAN-10-GATEWAY
 encapsulation dot1Q 10
 ip address 10.10.10.1 255.255.255.0
 ip helper-address 10.10.30.50

interface GigabitEthernet0/0.20
 description STAFF-STUDENT-VLAN-20-GATEWAY
 encapsulation dot1Q 20
 ip address 10.10.20.1 255.255.255.0
 ip helper-address 10.10.30.50

interface GigabitEthernet0/0.30
 description ONPREM-DC-OPENSHIFT-VLAN-30-GATEWAY
 encapsulation dot1Q 30
 ip address 10.10.30.1 255.255.255.0

interface GigabitEthernet0/0.99
 description MANAGEMENT-VLAN-99-GATEWAY
 encapsulation dot1Q 99
 ip address 10.10.99.1 255.255.255.0

! Uplink to Enterprise Perimeter ASA / Firepower Firewall (Inside Interface)
interface GigabitEthernet0/1
 description TRANSIT-TO-ENT-ASA-FIREWALL-INSIDE
 ip address 10.10.0.2 255.255.255.252
 no shutdown

! Loopback for Router ID & Management
interface Loopback0
 description ROUTER-ID-MGMT
 ip address 10.10.255.1 255.255.255.255

! --- Dynamic Routing: OSPF Area 0 ---
router ospf 1
 router-id 10.10.255.1
 log-adjacency-changes
 passive-interface default
 no passive-interface GigabitEthernet0/1
 network 10.10.0.0 0.0.0.3 area 0
 network 10.10.10.0 0.0.0.255 area 0
 network 10.10.20.0 0.0.0.255 area 0
 network 10.10.30.0 0.0.0.255 area 0
 network 10.10.99.0 0.0.0.255 area 0
 default-information originate

! Default Route pointing to ASA Firewall Inside IP
ip route 0.0.0.0 0.0.0.0 10.10.0.1

! --- Access Control Lists (ACLs) for Campus Segmentation ---
! Prevent VLAN 20 (General Campus) from directly probing Data Center Database Ports
ip access-list extended ACL-CAMPUS-RESTRICTIONS
 deny tcp 10.10.20.0 0.0.0.255 10.10.30.0 0.0.0.255 eq 3306
 deny tcp 10.10.20.0 0.0.0.255 10.10.30.0 0.0.0.255 eq 5432
 deny tcp 10.10.20.0 0.0.0.255 10.10.30.0 0.0.0.255 eq 27017
 deny tcp 10.10.20.0 0.0.0.255 10.10.30.0 0.0.0.255 eq 22
 deny tcp 10.10.20.0 0.0.0.255 10.10.99.0 0.0.0.255
 permit ip any any

interface GigabitEthernet0/0.20
 ip access-group ACL-CAMPUS-RESTRICTIONS in

! --- NetFlow / Telemetry for Cisco Stealthwatch / Secure Network Analytics ---
ip flow-export version 9
ip flow-export destination 10.10.30.60 2055
ip flow-cache timeout active 1

interface GigabitEthernet0/1
 ip flow ingress
 ip flow egress

! --- NTP & Logging ---
ntp server 209.165.200.225
logging buffered 64000 warnings
logging trap notifications

end
write memory

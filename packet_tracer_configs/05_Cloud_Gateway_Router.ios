! ==============================================================================
! CISCO VIRTUAL INTERNSHIP 2026 - CYBER SECURITY PROJECT
! Component: Public Cloud Transit Gateway & Cloud Edge Router
! Device: Cisco 2911 / 4331 / CSR1000v Virtual Router
! Hostname: CLOUD-TRANSIT-GW-01
! Description: Cloud Edge Termination, Site-to-Site IPsec VPN to Enterprise DC,
!              Multi-VPC Route Aggregation, and Cloud Security Group Enforcement
! ==============================================================================

enable
configure terminal

hostname CLOUD-TRANSIT-GW-01
no ip domain-lookup
ip domain-name cloud.netacad.internal
service password-encryption
enable secret Cisco@NetAcad2026!Secure

banner motd ^C
================================================================================
  PUBLIC CLOUD HYBRID TRANSIT GATEWAY (EKS / GKE / WORKLOAD VPC HUB)
  SECURE ENCRYPTED INTERCONNECT - STRICT POLICY ENFORCEMENT
================================================================================
^C

username admin privilege 15 secret Admin@NetAcad2026!P@ss
crypto key generate rsa modulus 2048
ip ssh version 2

line con 0
 exec-timeout 10 0
 logging synchronous
 login local

line vty 0 4
 exec-timeout 10 0
 logging synchronous
 login local
 transport input ssh

! --- WAN Interface facing ISP ---
interface GigabitEthernet0/0
 description WAN-UPLINK-TO-ISP
 ip address 198.51.100.2 255.255.255.252
 no shutdown

! --- Cloud VPC Subnets & Inter-VPC Trunk (Uplink to Cloud Switch) ---
interface GigabitEthernet0/1
 description TRUNK-TO-CLOUD-WORKLOAD-SWITCH
 no shutdown

! Cloud Ingress / ALB Subnet (VLAN 10)
interface GigabitEthernet0/1.10
 description CLOUD-PUBLIC-INGRESS-ALB-VLAN10
 encapsulation dot1Q 10
 ip address 172.20.1.1 255.255.255.0

! Cloud Microservices / EKS Pod Subnet (VLAN 20)
interface GigabitEthernet0/1.20
 description CLOUD-EKS-MICROSERVICES-VLAN20
 encapsulation dot1Q 20
 ip address 172.20.2.1 255.255.255.0

! Cloud Secure Database / Persistence Subnet (VLAN 30)
interface GigabitEthernet0/1.30
 description CLOUD-DATABASE-TIER-VLAN30
 encapsulation dot1Q 30
 ip address 172.20.3.1 255.255.255.0

! --- Static Routing & Default Gateway ---
ip route 0.0.0.0 0.0.0.0 198.51.100.1

! --- Site-to-Site IPsec VPN (Termination to Enterprise Perimeter ASA) ---
! Crypto ACL: Traffic from Cloud VPC (172.20.0.0/16) to On-Prem Data Center (10.10.0.0/16)
ip access-list extended ACL-CLOUD-TO-ONPREM-VPN
 permit ip 172.20.0.0 0.0.255.255 10.10.0.0 0.0.255.255

! IKEv1 / IKEv2 ISAKMP Policy
crypto isakmp policy 10
 encr aes 256
 hash sha256
 authentication pre-share
 group 14
 lifetime 86400

crypto isakmp key CiscoNetAcadHybridSecret2026! address 203.0.113.2

! IPsec Transform Set
crypto ipsec transform-set TS-CLOUD-HYBRID esp-aes 256 esp-sha256-hmac
 mode tunnel

! Crypto Map Binding
crypto map CM-CLOUD-HYBRID 10 ipsec-isakmp
 set peer 203.0.113.2
 set transform-set TS-CLOUD-HYBRID
 match address ACL-CLOUD-TO-ONPREM-VPN
 set security-association lifetime seconds 28800

interface GigabitEthernet0/0
 crypto map CM-CLOUD-HYBRID

! --- Cloud Security Groups / Network ACL Emulation ---
! Rule: Database Subnet (172.20.3.0/24) can ONLY receive SQL (3306/5432) from Microservices (172.20.2.0/24) or On-Prem Admin (10.10.99.0/24)
ip access-list extended ACL-CLOUD-DB-SECURITY-GROUP
 permit tcp 172.20.2.0 0.0.0.255 172.20.3.0 0.0.0.255 eq 3306
 permit tcp 172.20.2.0 0.0.0.255 172.20.3.0 0.0.0.255 eq 5432
 permit tcp 10.10.99.0 0.0.0.255 172.20.3.0 0.0.0.255 eq 22
 deny ip any 172.20.3.0 0.0.0.255
 permit ip any any

interface GigabitEthernet0/1.30
 ip access-group ACL-CLOUD-DB-SECURITY-GROUP in

! Rule: Cloud Microservices Tier can receive traffic from Ingress ALB or On-Prem Faculty
ip access-list extended ACL-CLOUD-APP-SECURITY-GROUP
 permit tcp 172.20.1.0 0.0.0.255 172.20.2.0 0.0.0.255 eq 8080
 permit tcp 172.20.1.0 0.0.0.255 172.20.2.0 0.0.0.255 eq 443
 permit tcp 10.10.10.0 0.0.0.255 172.20.2.0 0.0.0.255 eq 8080
 permit tcp 10.10.10.0 0.0.0.255 172.20.2.0 0.0.0.255 eq 443
 permit icmp 10.10.0.0 0.0.255.255 172.20.2.0 0.0.0.255
 permit tcp 10.10.99.0 0.0.0.255 172.20.2.0 0.0.0.255 eq 22
 deny tcp any 172.20.2.0 0.0.0.255 eq 22
 permit ip any any

interface GigabitEthernet0/1.20
 ip access-group ACL-CLOUD-APP-SECURITY-GROUP in

end
write memory
